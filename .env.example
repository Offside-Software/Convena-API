# Server Port
PORT=6969

# Supabase Project credentials
SUPABASE_URL=https://<project_id>.supabase.co
SUPABASE_KEY=<supabase_key>

# PostgreSQL connection string (Supabase Session Pooler for SQLx Compatibility)
POSTGRESQL_DATABASE_URL=postgresql://postgres.<host>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/<database_name>

# Optional direct DB credentials (if POSTGRESQL_DATABASE_URL is not set):
POSTGRESQL_HOST=locahost
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres